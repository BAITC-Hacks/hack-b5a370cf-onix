# AI-объяснения и AI-советник. Достаточно одного ключа; без ключей работает встроенный шаблонный анализ.
# Приоритет: LLM_PROVIDER (openai | anthropic), иначе Anthropic при наличии ключа, иначе OpenAI.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# LLM_PROVIDER=openai

# Постоянный общий рейтинг для Vercel: заполните обе переменные из Upstash Console.
# Без них рейтинг хранится в локальном data/leaderboard.json (подходит для локального запуска).
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Демо-режим для Vercel без Upstash: AI и рейтинг работают с лимитами в памяти инстанса и рейтингом во временном файле.
# Только для показа жюри; для настоящей публичной эксплуатации используйте Upstash.
# AKIM_DEMO_MODE=1
